rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function release() {
      return get(/databases/$(database)/documents/harueumConfig/release).data;
    }
    function groupsEnabled() { return release().get('groups', false) == true; }
    function groupStoriesEnabled() { return groupsEnabled() && release().get('groupStories', false) == true; }
    function plazaEnabled() {
      return request.auth != null && groupStoriesEnabled() && release().get('plaza', false) == true
        && hasEnrollment(request.auth.uid) && privateStudent(request.auth.uid);
    }
    function accountRef(uid) { return /databases/$(database)/documents/users/$(uid)/harueum/account; }
    function hasEnrollment(uid) {
      return exists(accountRef(uid)) && get(accountRef(uid)).data.policyVersion == release().policyVersion;
    }
    function privateStudent(uid) {
      return !exists(accountRef(uid)) || get(accountRef(uid)).data.type == 'student';
    }
    function schoolRef(uid) { return /databases/$(database)/documents/users/$(uid)/harueum/school; }
    function inviteRef(id) { return /databases/$(database)/documents/harueumInvites/$(id); }
    function matchesSchool(uid, group) {
      let school = get(schoolRef(uid)).data;
      return school.school == group.school && school.grade == group.grade && school.room == group.room;
    }
    function sameClass(uid, group) { return group.kind != 'class' || matchesSchool(uid, group); }
    function classYear() {
      let seoul = request.time + duration.value(9, 'h');
      return seoul.month() < 3 ? seoul.year() - 1 : seoul.year();
    }
    function groupIdentity(data, uid) {
      return (data.kind == 'class' && sameClass(uid, data) && data.year == classYear())
        || (data.kind == 'study' && !data.keys().hasAny(['school', 'grade', 'room', 'year']));
    }
    function groupRef(id) { return /databases/$(database)/documents/harueumGroups/$(id); }
    function memberRef(id, uid) { return /databases/$(database)/documents/harueumGroups/$(id)/members/$(uid); }
    function membershipIndex(id, uid) { return /databases/$(database)/documents/users/$(uid)/harueumMemberships/$(id); }
    function joinRef(id, uid) { return /databases/$(database)/documents/harueumGroups/$(id)/requests/$(uid); }
    function groupMember(id) {
      return request.auth != null && groupsEnabled() && exists(memberRef(id, request.auth.uid));
    }
    function groupOwner(id) {
      return request.auth != null && groupsEnabled() && get(groupRef(id)).data.owner == request.auth.uid;
    }
    function sized(value, max) {
      return value is string && value.size() <= max && value.matches('[\\s\\S]*[^\\s][\\s\\S]*');
    }
    function allowedGroupFor(data, uid) {
      let account = get(accountRef(uid)).data;
      return hasEnrollment(uid) && data.kind in ['class', 'study'] && sameClass(uid, data)
        && (account.type == 'student' || (account.stage == 'study' && data.kind == 'study')
          || (account.stage == 'school' && data.kind == 'class'));
    }
    function personalSchedule(data) {
      return data.keys().hasOnly(['day', 'title', 'kind', 'subject', 'note', 'start', 'end', 'updatedAt'])
        && data.day is string && data.day.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
        && sized(data.title, 80) && data.note is string && data.note.size() <= 4000
        && data.kind in ['class', 'lunch', 'exam', 'task', 'study', 'personal'] && data.subject in ['', 'math', 'english']
        && ((data.start == '' && data.end == '') || (data.start is string && data.end is string
          && data.start.matches('([01][0-9]|2[0-3]):[0-5][0-9]') && data.end.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
          && (int(data.start.split(':')[0]) * 60 + int(data.start.split(':')[1]))
          < (int(data.end.split(':')[0]) * 60 + int(data.end.split(':')[1]))))
        && data.updatedAt == request.time;
    }
    function groupText(value, max) {
      return sized(value, max) && !value.lower().matches('[\\s\\S]*(https?:|www[.]|@[a-z0-9_])[\\s\\S]*');
    }
    match /harueumConfig/release {
      allow get: if true;
    }
    function changeRef(uid) { return /databases/$(database)/documents/users/$(uid)/harueum/changeLimit; }
    function ownerCountRef(uid) { return /databases/$(database)/documents/users/$(uid)/harueum/ownedGroups; }
    function accountChanged(uid) {
      return exists(accountRef(uid)) && (get(accountRef(uid)).data.type != getAfter(accountRef(uid)).data.type
        || get(accountRef(uid)).data.stage != getAfter(accountRef(uid)).data.stage);
    }
    function schoolChanged(uid) {
      return existsAfter(schoolRef(uid)) && (!exists(schoolRef(uid))
        || getAfter(schoolRef(uid)).data.diff(get(schoolRef(uid)).data).affectedKeys().hasAny(['school', 'grade', 'room']));
    }
    function changeHistory(uid, seq) { return /databases/$(database)/documents/users/$(uid)/settingsHistory/$(string(seq)); }
    function currentChange(uid) {
      let next = getAfter(changeRef(uid)).data;
      return next.first == request.time && getAfter(changeHistory(uid, next.seq)).data.at == request.time;
    }
    function typeChangeAllowed(uid) {
      return release().get('ownershipIndexed', false) == true
        && countBefore(uid) == 0
        && (!existsAfter(ownerCountRef(uid)) || getAfter(ownerCountRef(uid)).data.count == 0);
    }
    match /users/{uid}/harueum/changeLimit {
      function validChange(next, previous) {
        return next.keys().hasOnly(['seq', 'first', 'second', 'third']) && next.seq == previous.seq + 1
          && next.first == request.time && next.second == previous.first && next.third == previous.second
          && (previous.third == null || previous.third <= request.time - duration.value(90, 'd'))
          && (accountChanged(uid) || schoolChanged(uid))
          && getAfter(changeHistory(uid, next.seq)).data.at == request.time;
      }
      allow get: if learningOwner(uid);
      allow create: if learningOwner(uid) && validChange(request.resource.data, { 'seq': 0, 'first': null, 'second': null, 'third': null });
      allow update: if learningOwner(uid) && validChange(request.resource.data, resource.data);
    }
    match /users/{uid}/settingsHistory/{sequence} {
      allow read: if learningOwner(uid);
      allow create: if learningOwner(uid)
        && request.resource.data.keys().hasOnly(['at', 'account', 'school'])
        && request.resource.data.at == request.time
        && request.resource.data.account == accountChanged(uid) && request.resource.data.school == schoolChanged(uid)
        && sequence == string(getAfter(changeRef(uid)).data.seq)
        && getAfter(changeRef(uid)).data.first == request.time;
    }
    function countBefore(uid) { return exists(ownerCountRef(uid)) ? get(ownerCountRef(uid)).data.count : 0; }
    function ownerCountChange(uid, id, delta) {
      let next = getAfter(ownerCountRef(uid)).data;
      return next.group == id && next.at == request.time && next.count == countBefore(uid) + delta;
    }
    match /users/{uid}/harueum/ownedGroups {
      allow get: if learningOwner(uid);
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['count', 'group', 'at'])
        && request.resource.data.group.matches('[a-f0-9]{32}') && request.resource.data.at == request.time
        && request.resource.data.count is int && request.resource.data.count >= 0
        && ((request.resource.data.count == countBefore(uid) + 1
          && getAfter(groupRef(request.resource.data.group)).data.owner == uid
          && (!exists(groupRef(request.resource.data.group)) || get(groupRef(request.resource.data.group)).data.owner != uid))
        || (request.resource.data.count == countBefore(uid) - 1
          && get(groupRef(request.resource.data.group)).data.owner == uid
          && getAfter(groupRef(request.resource.data.group)).data.owner != uid));
    }

    match /users/{uid}/harueum/account {
      function validEnrollment(data) {
        let seoul = request.time + duration.value(9, 'h');
        return data.keys().hasOnly(['type', 'stage', 'schoolYear', 'policyVersion', 'ageConfirmed', 'termsAccepted', 'privacyAccepted', 'acceptedAt'])
          && ((data.type == 'student' && data.stage in ['high1', 'high2', 'high3', 'repeat', 'relearn'])
            || (data.type == 'teacher' && data.stage in ['school', 'academy', 'study']))
          && data.schoolYear == (seoul.month() < 3 ? seoul.year() - 1 : seoul.year())
          && data.policyVersion == release().policyVersion && sized(data.policyVersion, 100)
          && release().termsUrl.matches('https://.+') && release().privacyUrl.matches('https://.+')
          && data.ageConfirmed == true && data.termsAccepted == true && data.privacyAccepted == true && data.acceptedAt == request.time;
      }
      allow get: if learningOwner(uid);
      allow create: if learningOwner(uid) && validEnrollment(request.resource.data);
      allow update: if learningOwner(uid) && validEnrollment(request.resource.data)
        && (!accountChanged(uid) || (currentChange(uid)
          && (request.resource.data.type == resource.data.type || typeChangeAllowed(uid))));
    }
    match /users/{uid}/harueum/school {
      allow get: if learningOwner(uid);
      allow create, update: if learningOwner(uid)
        && request.resource.data.keys().hasOnly(['school', 'grade', 'room', 'updatedAt'])
        && request.resource.data.school.matches('[0-9]{7}')
        && request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 3
        && request.resource.data.room is int && request.resource.data.room >= 1 && request.resource.data.room <= 50
        && request.resource.data.updatedAt == request.time && (!schoolChanged(uid) || currentChange(uid));
    }
    match /users/{uid}/schedule/{eventId} {
      allow read, delete: if learningOwner(uid) && privateStudent(uid);
      allow create, update: if learningOwner(uid) && privateStudent(uid) && personalSchedule(request.resource.data);
    }
    match /users/{uid}/dayNotes/{day} {
      allow get: if learningOwner(uid) && privateStudent(uid);
      allow create, update: if learningOwner(uid) && privateStudent(uid)
        && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['body', 'updatedAt'])
        && request.resource.data.body is string && request.resource.data.body.size() <= 8000
        && request.resource.data.updatedAt == request.time;
    }
    match /harueumInvites/{id} {
      allow get: if request.auth != null && groupsEnabled() && hasEnrollment(request.auth.uid)
        && (!exists(inviteRef(id)) || sameClass(request.auth.uid, resource.data));
      allow create: if request.auth != null && groupsEnabled()
        && getAfter(groupRef(id)).data.owner == request.auth.uid
        && getAfter(groupRef(id)).data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['name', 'kind', 'school', 'grade', 'room', 'year'])
        && request.resource.data.name == getAfter(groupRef(id)).data.name
        && request.resource.data.kind == getAfter(groupRef(id)).data.kind
        && request.resource.data.get('school', '') == getAfter(groupRef(id)).data.get('school', '')
        && request.resource.data.get('grade', 0) == getAfter(groupRef(id)).data.get('grade', 0)
        && request.resource.data.get('room', 0) == getAfter(groupRef(id)).data.get('room', 0)
        && request.resource.data.get('year', 0) == getAfter(groupRef(id)).data.get('year', 0);
    }
    match /users/{uid}/harueumMemberships/{id} {
      allow read: if learningOwner(uid) && groupsEnabled();
      allow create: if request.auth != null && groupsEnabled()
        && getAfter(memberRef(id, uid)).data.joinedAt == request.time
        && request.resource.data.keys().hasOnly(['joinedAt']) && request.resource.data.joinedAt == request.time;
      allow delete: if learningOwner(uid) && groupsEnabled() && !existsAfter(memberRef(id, uid));
    }
    match /harueumGroups/{id} {
      allow get: if groupMember(id);
      allow create: if request.auth != null && groupsEnabled() && id.matches('[a-f0-9]{32}')
        && request.resource.data.keys().hasOnly(['name', 'kind', 'owner', 'createdAt', 'school', 'grade', 'room', 'year'])
        && request.resource.data.owner == request.auth.uid && request.resource.data.createdAt == request.time
        && groupText(request.resource.data.name, 60) && groupIdentity(request.resource.data, request.auth.uid)
        && allowedGroupFor(request.resource.data, request.auth.uid)
        && getAfter(memberRef(id, request.auth.uid)).data.joinedAt == request.time
        && ownerCountChange(request.auth.uid, id, 1);
      allow update: if groupOwner(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'transferredAt'])
        && request.resource.data.transferredAt == request.time
        && ownerCountChange(request.auth.uid, id, -1)
        && ownerCountChange(request.resource.data.owner, id, 1)
        && request.resource.data.owner is string && request.resource.data.owner != request.auth.uid
        && exists(memberRef(id, request.resource.data.owner))
        && allowedGroupFor(resource.data, request.resource.data.owner);
      match /transferNotices/{uid} {
        allow get: if learningOwner(uid) && groupMember(id);
        allow create, update: if learningOwner(uid) && groupMember(id)
          && request.resource.data.keys().hasOnly(['transfer', 'confirmedAt'])
          && request.resource.data.transfer == get(groupRef(id)).data.transferredAt
          && request.resource.data.confirmedAt == request.time;
      }
      match /memberDetails/{uid} {
        // No client writes or list access. A future approved aggregation job owns this path.
        allow get: if groupMember(id) && (learningOwner(uid) || (groupOwner(id)
          && get(groupRef(id)).data.kind == 'study'
          && get(groupRef(id)).data.get('detailSharing', false)
          && exists(memberRef(id, uid)) && exists(/databases/$(database)/documents/harueumGroups/$(id)/transferNotices/$(uid))
          && get(/databases/$(database)/documents/harueumGroups/$(id)/transferNotices/$(uid)).data.transfer
            == get(groupRef(id)).data.get('transferredAt', null)));
      }
      match /requests/{uid} {
        allow get: if (learningOwner(uid) && groupsEnabled()) || groupOwner(id);
        allow list: if groupOwner(id);
        allow create: if learningOwner(uid) && groupsEnabled() && hasEnrollment(uid)
          && exists(inviteRef(id)) && sameClass(uid, get(inviteRef(id)).data) && !exists(memberRef(id, uid))
          && request.resource.data.keys().hasOnly(['policy', 'createdAt'])
          && request.resource.data.policy == 1 && request.resource.data.createdAt == request.time;
        allow delete: if (learningOwner(uid) && groupsEnabled()) || groupOwner(id);
      }
      match /members/{uid} {
        allow get: if groupMember(id);
        allow create: if request.auth != null && groupsEnabled()
          && request.resource.data.keys().hasOnly(['policy', 'joinedAt'])
          && request.resource.data.policy == 1 && request.resource.data.joinedAt == request.time
          && getAfter(membershipIndex(id, uid)).data.joinedAt == request.time
          && ((learningOwner(uid) && !exists(groupRef(id)) && getAfter(groupRef(id)).data.owner == uid
              && getAfter(groupRef(id)).data.createdAt == request.time)
            || (groupOwner(id) && exists(joinRef(id, uid)) && get(joinRef(id, uid)).data.policy == 1
              && hasEnrollment(uid) && sameClass(uid, get(groupRef(id)).data) && !existsAfter(joinRef(id, uid))));
        allow delete: if learningOwner(uid) && groupMember(id) && !groupOwner(id)
          && !existsAfter(membershipIndex(id, uid));
      }
      match /posts/{postId} {
        allow read: if groupStoriesEnabled() && groupMember(id) && resource.data.hidden == false;
        allow create: if groupStoriesEnabled() && groupMember(id)
          && request.resource.data.keys().hasOnly(['authorId', 'body', 'hidden', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid && request.resource.data.hidden == false
          && request.resource.data.createdAt == request.time && groupText(request.resource.data.body, 2000);
        allow update: if groupStoriesEnabled() && groupMember(id)
          && (groupOwner(id) || resource.data.authorId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'hidden'])
          && request.resource.data.hidden == true
          && request.resource.data.body == (resource.data.authorId == request.auth.uid ? '' : resource.data.body);
        function visibleGroupPost() {
          return groupStoriesEnabled() && groupMember(id) && get(/databases/$(database)/documents/harueumGroups/$(id)/posts/$(postId)).data.hidden == false;
        }
        match /comments/{commentId} {
          allow read: if visibleGroupPost();
          allow create: if visibleGroupPost()
            && canInteract(get(/databases/$(database)/documents/harueumGroups/$(id)/posts/$(postId)).data.authorId)
            && request.resource.data.keys().hasOnly(['authorId', 'body', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.createdAt == request.time && groupText(request.resource.data.body, 1000);
          allow delete: if visibleGroupPost() && resource.data.authorId == request.auth.uid;
        }
      }
    }
    match /users/{uid}/harueumGroupReports/{id} {
      allow get: if learningOwner(uid);
      allow create: if learningOwner(uid) && request.resource.data.groupId is string
        && groupMember(request.resource.data.groupId)
        && request.resource.data.keys().hasOnly(['groupId', 'target', 'reason', 'createdAt'])
        && sized(request.resource.data.target, 128) && sized(request.resource.data.reason, 500)
        && request.resource.data.createdAt == request.time;
    }

    function learningOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function learningSubject(subject) { return subject in ['math', 'english']; }
    function learningToday(day) {
      let seoul = request.time + duration.value(9, 'h');
      let parts = day.split('-');
      return day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && int(parts[0]) == seoul.year() && int(parts[1]) == seoul.month() && int(parts[2]) == seoul.day();
    }
    function dailyAnswer(uid, day, subject, index) {
      return /databases/$(database)/documents/users/$(uid)/learningDays/$(day)/subjects/$(subject)/answers/$(index);
    }
    function dailyPoint(uid, day, subject, index) {
      return get(dailyAnswer(uid, day, subject, index)).data.correct == true ? 1 : 0;
    }
    match /users/{uid}/harueum/learningTotals { allow get: if learningOwner(uid); }
    match /users/{uid}/learning/{attemptId} {
      allow read: if learningOwner(uid);
      allow create: if learningOwner(uid)
        && request.resource.data.keys().hasAll(['subject', 'label', 'mode', 'result', 'occurredAt', 'createdAt'])
        && request.resource.data.keys().hasOnly(['subject', 'label', 'mode', 'result', 'occurredAt', 'createdAt', 'answer', 'prompt', 'elapsedMs'])
        && learningSubject(request.resource.data.subject)
        && request.resource.data.label is string && request.resource.data.label.size() >= 1 && request.resource.data.label.size() <= 160
        && request.resource.data.mode is string && request.resource.data.mode.size() >= 1 && request.resource.data.mode.size() <= 24
        && request.resource.data.result in ['correct', 'wrong', 'seen', 'hinted']
        && request.resource.data.get('answer', '') is string && request.resource.data.get('answer', '').size() <= 300
        && request.resource.data.get('prompt', '') is string && request.resource.data.get('prompt', '').size() <= 1200
        && request.resource.data.get('elapsedMs', 0) is int && request.resource.data.get('elapsedMs', 0) >= 0
        && request.resource.data.get('elapsedMs', 0) <= 604800000
        && request.resource.data.occurredAt is int && request.resource.data.occurredAt > 0
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /users/{uid}/learningDays/{day}/subjects/{subject}/answers/{index} {
      allow read: if learningOwner(uid);
      allow create: if learningOwner(uid) && learningSubject(subject) && learningToday(day) && index in ['0', '1', '2']
        && request.resource.data.keys().hasAll(['correct', 'createdAt'])
        && request.resource.data.keys().hasOnly(['correct', 'createdAt'])
        && request.resource.data.correct is bool && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /pulleemDays/{day}/subjects/{subject}/scores/{uid} {
      allow get, list: if false;
      allow create, update: if false;
      allow delete: if learningOwner(uid);
    }
    // Retired login-service records, if any, remain inaccessible to clients.
    function blocks(uid, other) {
      return exists(/databases/$(database)/documents/users/$(uid)/blockedAuthors/$(other));
    }
    function canInteract(other) {
      return learningOwner(other) || (!blocks(other, request.auth.uid) && !blocks(request.auth.uid, other));
    }
    function visibilityStamp() {
      return request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
    }
    function validReport() {
      return request.resource.data.keys().hasOnly(['reason', 'note', 'createdAt'])
        && request.resource.data.reason in ['spam', 'abuse', 'privacy', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time;
    }
    function canReport(path) {
      return exists(path) && get(path).data.get('deleted', false) == false
        && get(path).data.authorId != request.auth.uid;
    }
    match /users/{uid}/hiddenPosts/{postId} {
      allow read, delete: if learningOwner(uid);
      allow create, update: if learningOwner(uid) && visibilityStamp()
        && exists(/databases/$(database)/documents/posts/$(postId));
    }
    match /users/{uid}/blockedAuthors/{authorId} {
      allow read, delete: if learningOwner(uid);
      allow create, update: if learningOwner(uid) && uid != authorId && visibilityStamp();
    }
    match /users/{uid}/reports/{postId} {
      allow get: if learningOwner(uid);
      allow create: if learningOwner(uid) && validReport()
        && canReport(/databases/$(database)/documents/posts/$(postId));
      match /reportedComments/{commentId} {
        allow get: if learningOwner(uid);
        allow create: if learningOwner(uid) && validReport()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && get(/databases/$(database)/documents/posts/$(postId)).data.get('deleted', false) == false
          && canReport(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId));
      }
    }

    match /loginAttempts/{id} { allow read, write: if false; }
    match /users/{uid}/activity/{activityId} {
      function own() { return request.auth != null && request.auth.uid == uid; }
      function source(data) {
        let postId = data.postId;
        let reaction = /databases/$(database)/documents/posts/$(postId)/reactions/$(uid);
        let repost = /databases/$(database)/documents/posts/$('repost_' + uid + '_' + postId);
        return data.postId is string && data.postId.matches('[^/]+') && (
          (data.kind in ['like', 'dislike'] && activityId == 'reaction_' + postId && existsAfter(reaction) && getAfter(reaction).data.kind == data.kind)
          || (data.kind == 'repost' && activityId == 'repost_' + postId && existsAfter(repost) && getAfter(repost).data.deleted == false));
      }
      allow read: if own();
      allow create, update: if own() && request.resource.data.keys().hasAll(['postId', 'kind', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['postId', 'kind', 'updatedAt']) && request.resource.data.updatedAt == request.time && source(request.resource.data);
      allow delete: if own() && (!exists(/databases/$(database)/documents/users/$(uid)/activity/$(activityId)) || !source(resource.data));
    }
    function validHandle(handle) { return handle is string && handle.matches('[a-z][a-z0-9_]{2,19}'); }
    function profileRef(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function limitRef(uid) { return /databases/$(database)/documents/profileLimits/$(uid); }
    function handleRef(handle) { return /databases/$(database)/documents/handles/$(handle); }
    function validSocial(links, index) {
      return links.size() <= index || (links[index] is string && links[index].size() <= 500
        && links[index].matches('https://[^\\s/@:]+(\\.[^\\s/@:]+)+(:[0-9]+)?([/?#][^\\s]*)?'));
    }
    function validProfile(data) {
      return data.keys().hasAll(['name', 'handle', 'bio', 'links', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'handle', 'bio', 'links', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 30 && data.name.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && validHandle(data.handle) && data.bio is string && data.bio.size() <= 1000
        && data.links is list && data.links.size() <= 5 && data.links.toSet().size() == data.links.size()
        && validSocial(data.links, 0) && validSocial(data.links, 1) && validSocial(data.links, 2) && validSocial(data.links, 3) && validSocial(data.links, 4)
        && data.updatedAt == request.time
        && getAfter(handleRef(data.handle)).data.uid == request.auth.uid;
    }
    match /profiles/{uid} {
      allow get: if learningOwner(uid) || !exists(profileRef(uid)) || resource.data.get('links', []).size() == 0;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == uid && validProfile(request.resource.data)
        && request.resource.data.links == [] && request.resource.data.createdAt == request.time
        && getAfter(limitRef(uid)).data.last == null && getAfter(limitRef(uid)).data.previous == null;
      allow update: if request.auth != null && request.auth.uid == uid && validProfile(request.resource.data)
        && (request.resource.data.links == [] || request.resource.data.links == resource.data.links)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'handle', 'bio', 'links', 'updatedAt'])
        && (request.resource.data.handle == resource.data.handle || (
          !existsAfter(handleRef(resource.data.handle))
          && getAfter(limitRef(uid)).data.last == request.time
          && getAfter(limitRef(uid)).data.previous == get(limitRef(uid)).data.last
          && (get(limitRef(uid)).data.previous == null || get(limitRef(uid)).data.previous <= request.time - duration.value(14, 'd'))));
      allow delete: if false;
    }
    match /handles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && validHandle(handle)
        && request.resource.data.keys().hasAll(['uid']) && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(profileRef(request.auth.uid)).data.handle == handle;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && getAfter(profileRef(request.auth.uid)).data.handle != handle;
    }
    match /profileLimits/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['last', 'previous']) && request.resource.data.keys().hasOnly(['last', 'previous'])
        && request.resource.data.last == null && request.resource.data.previous == null
        && !exists(profileRef(uid)) && getAfter(profileRef(uid)).data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['last', 'previous']) && request.resource.data.keys().hasOnly(['last', 'previous'])
        && request.resource.data.last == request.time && request.resource.data.previous == resource.data.last
        && (resource.data.previous == null || resource.data.previous <= request.time - duration.value(14, 'd'))
        && get(profileRef(uid)).data.handle != getAfter(profileRef(uid)).data.handle;
      allow delete: if false;
    }

    match /posts/{postId} {
      function signedIn() { return plazaEnabled(); }
      function owner() { return signedIn() && resource.data.authorId == request.auth.uid; }
      function nonblank(value, maximum) {
        return value is string && value.size() >= 1 && value.size() <= maximum
          && value.matches('[\\s\\S]*[^\\s][\\s\\S]*');
      }
      function fields(data) {
        return data.keys().hasAll(['body', 'authorId', 'authorName', 'createdAt'])
          && data.keys().hasOnly(['body', 'authorId', 'authorName', 'createdAt', 'kind', 'originalId', 'tags', 'deleted', 'updatedAt'])
          && nonblank(data.authorName, 30)
          && data.get('tags', []) is list && data.get('tags', []).size() <= 10
          && data.get('deleted', false) is bool;
      }
      function originalExists(data) {
        let id = data.originalId;
        let path = /databases/$(database)/documents/posts/$(id);
        return id is string && id.matches('[^/]+')
          && exists(path) && get(path).data.get('kind', 'post') == 'post'
          && get(path).data.get('deleted', false) == false && canInteract(get(path).data.authorId);
      }
      function repostBody(body) { return body == '' || nonblank(body, 2000); }
      function content(data) {
        return (data.get('kind', 'post') == 'post' && data.get('originalId', null) == null && nonblank(data.body, 2000))
          || (data.get('kind', 'post') == 'repost' && repostBody(data.body) && originalExists(data)
            && postId == 'repost_' + request.auth.uid + '_' + data.originalId);
      }
      allow read: if plazaEnabled();
      allow create: if signedIn() && fields(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(['updatedAt'])
        && request.resource.data.get('deleted', false) == false
        && content(request.resource.data);
      allow update: if owner() && fields(request.resource.data) && (
        // Normal edit or content-erasing soft deletion; identity never changes.
        (resource.data.get('deleted', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'tags', 'updatedAt', 'deleted'])
          && request.resource.data.updatedAt == request.time
          && ((request.resource.data.get('deleted', false) == true && request.resource.data.body == '' && request.resource.data.get('tags', []) == [])
            || (request.resource.data.get('deleted', false) == false && ((resource.data.get('kind', 'post') == 'post' && content(request.resource.data)) || (resource.data.get('kind', 'post') == 'repost' && repostBody(request.resource.data.body))))))
        // Reposting a previously removed reference reuses its deterministic ID.
        || (resource.data.get('kind', 'post') == 'repost' && resource.data.get('deleted', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'createdAt', 'body', 'tags', 'updatedAt'])
          && request.resource.data.deleted == false && request.resource.data.createdAt == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time) && content(request.resource.data))
      );
      allow delete: if false;

      function parent() { return get(/databases/$(database)/documents/posts/$(postId)).data; }
      function reactable() { return signedIn() && parent().get('deleted', false) == false && parent().get('kind', 'post') in ['post', 'repost']; }
      function beforeKind() {
        let path = /databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid);
        return exists(path) ? get(path).data.kind : 'none';
      }
      function afterKind() {
        let path = /databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid);
        return existsAfter(path) ? getAfter(path).data.kind : 'none';
      }
      function oldCount(key) {
        let path = /databases/$(database)/documents/posts/$(postId)/stats/reactions;
        return exists(path) ? get(path).data[key] : 0;
      }
      function delta(kind) { return (afterKind() == kind ? 1 : 0) - (beforeKind() == kind ? 1 : 0); }
      function validCounts(data) {
        return data.keys().hasAll(['likes', 'dislikes']) && data.keys().hasOnly(['likes', 'dislikes'])
          && data.likes is int && data.dislikes is int && data.likes >= 0 && data.dislikes >= 0
          && data.likes == oldCount('likes') + delta('like')
          && data.dislikes == oldCount('dislikes') + delta('dislike');
      }
      function commentActive(path, after) {
        return after ? (existsAfter(path) && getAfter(path).data.deleted == false) : (exists(path) && get(path).data.deleted == false);
      }
      function commentCounts(data) {
        let comment = /databases/$(database)/documents/posts/$(postId)/comments/$(data.lastCommentId);
        let counts = /databases/$(database)/documents/posts/$(postId)/stats/comments;
        let before = exists(counts) ? get(counts).data.count : 0;
        return data.keys().hasAll(['count', 'lastCommentId']) && data.keys().hasOnly(['count', 'lastCommentId'])
          && data.count is int && data.count >= 0 && data.lastCommentId is string && data.lastCommentId.matches('[^/]+')
          && (exists(comment) || existsAfter(comment))
          && (!exists(comment) || get(comment).data.authorId == request.auth.uid)
          && (!existsAfter(comment) || getAfter(comment).data.authorId == request.auth.uid)
          && data.count == before + (commentActive(comment, true) ? 1 : 0) - (commentActive(comment, false) ? 1 : 0);
      }
      function commentsOpen() { return plazaEnabled() && parent().get('deleted', false) == false; }
      match /comments/{commentId} {
        function validComment(data) {
          return data.keys().hasAll(['body', 'authorId', 'authorName', 'createdAt', 'deleted'])
            && data.keys().hasOnly(['body', 'authorId', 'authorName', 'createdAt', 'deleted', 'updatedAt'])
            && nonblank(data.authorName, 30) && data.deleted is bool;
        }
        function countsMatch() {
          let path = /databases/$(database)/documents/posts/$(postId)/stats/comments;
          return getAfter(path).data.lastCommentId == commentId && commentCounts(getAfter(path).data);
        }
        allow read: if commentsOpen();
        allow create: if signedIn() && commentsOpen() && canInteract(parent().authorId) && validComment(request.resource.data)
          && request.resource.data.authorId == request.auth.uid && request.resource.data.createdAt == request.time
          && !request.resource.data.keys().hasAny(['updatedAt']) && request.resource.data.deleted == false
          && nonblank(request.resource.data.body, 1000) && countsMatch();
        allow update: if signedIn() && commentsOpen() && resource.data.authorId == request.auth.uid && resource.data.deleted == false
          && validComment(request.resource.data) && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'deleted', 'updatedAt'])
          && ((request.resource.data.deleted == false && nonblank(request.resource.data.body, 1000))
            || (request.resource.data.deleted == true && request.resource.data.body == '' && countsMatch()));
        allow delete: if false;
      }
      match /reactions/{uid} {
        // Only the author can list identities. A reactor can get their own choice.
        allow get: if signedIn() && (request.auth.uid == uid || parent().authorId == request.auth.uid);
        allow list: if signedIn() && parent().authorId == request.auth.uid;
        allow create, update: if reactable() && request.auth.uid == uid && canInteract(parent().authorId)
          && request.resource.data.keys().hasAll(['kind', 'name']) && request.resource.data.keys().hasOnly(['kind', 'name'])
          && request.resource.data.kind in ['like', 'dislike'] && nonblank(request.resource.data.name, 30)
          && validCounts(getAfter(/databases/$(database)/documents/posts/$(postId)/stats/reactions).data);
        allow delete: if reactable() && request.auth.uid == uid
          && validCounts(getAfter(/databases/$(database)/documents/posts/$(postId)/stats/reactions).data);
      }
      match /stats/{statId} {
        allow read: if plazaEnabled();
        allow create, update: if (statId == 'reactions' && reactable() && validCounts(request.resource.data))
          || (statId == 'comments' && signedIn() && commentsOpen() && commentCounts(request.resource.data));
        allow delete: if false;
      }
    }
  }
}
